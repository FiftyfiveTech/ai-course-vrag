# Names only — never real values. Real keys live in ~/.config/, outside the repo.
# `make doctor` reads these from the process env, then .env, then
# ~/.config/ai-course-vrag.env — first hit wins, and it prints where it found each one.
HF_TOKEN=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional — tracing. WARN, not FAIL: the MVP gate does not need them.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
