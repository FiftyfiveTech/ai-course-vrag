# Names only — never real values. Real keys live in ~/.config/, outside the repo.
# `make doctor` reads these from the process env, then .env, then
# ~/.config/ai-course-vrag.env — first hit wins, and it prints where it found each one.
HF_TOKEN=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional — tracing. WARN, not FAIL: the MVP gate does not need them.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Where the ollama daemon is. Unset means 127.0.0.1:11434, which is right on a laptop
# running `ollama serve`. The compose stack sets it to http://ollama:11434 in the Dockerfile
# because the daemon is a sibling service there — see compose.yaml. Read by the python
# ollama client and by src/doctor.py; not a secret, listed here because it is the one
# variable that changes what the pipeline talks to.
OLLAMA_HOST=
