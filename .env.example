# Names only — never real values. Real keys live in ~/.config/, outside the repo.
# `make doctor` reads these from the process env, then .env, then
# ~/.config/ai-course-vrag.env — first hit wins, and it prints where it found each one.
HF_TOKEN=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional — tracing. WARN, not FAIL: the MVP gate does not need them.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Where the ollama daemon is. Unset means 127.0.0.1:11434, which is right on a laptop
# running `ollama serve`. The compose stack sets it to http://ollama:11434 in the Dockerfile
# because the daemon is a sibling service there — see compose.yaml. Read by the python
# ollama client and by src/doctor.py; not a secret, listed here because it is the one
# variable that changes what the pipeline talks to.
OLLAMA_HOST=

# Optional — Microsoft Graph, app-only. WARN, not FAIL: the pipeline and every gate run
# without these. They are what `src/graph.py` needs to read a Teams meeting's own transcript,
# which is the one source of text that already knows WHO was speaking. Values come from an
# Azure app registration; ask a tenant administrator for the three below plus admin consent
# for the roles listed in config.toml [graph] required_roles.
#
#   GRAPH_TENANT_ID      Directory (tenant) ID  — a GUID, from the app's Overview blade
#   GRAPH_CLIENT_ID      Application (client) ID — a GUID, same blade
#   GRAPH_CLIENT_SECRET  the secret VALUE, not the Secret ID; shown once, then never again
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
