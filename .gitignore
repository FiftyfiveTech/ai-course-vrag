.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
runs/
*.wav
*.mp4

# VRAG-004: the corpus is pointers only. Video-MME's licence forbids redistributing it,
# so a local working copy of any media must never be committed. See data/corpus/PROVENANCE.md
data/corpus/media/
*.mkv
*.webm
*.m4a

# VRAG-005: sample videos are generated (`make sample`) or fetched from the manifest url
# (`make sample-real`), never committed. Same licence reason as data/corpus/media/.
samples/

# VRAG-017: the Chroma vector store is a build artefact, rebuilt by `make index-dev` from
# the cached chunk tables. Committing it would put transcript text - derived from Video-MME
# media - in the repo, which is the same licence problem as committing the video.
chroma/

# VRAG API: the OpenAPI document is generated (`make openapi > openapi.json`) from
# schemas/api.py, so committing it would give a frontend two contracts to disagree about.
openapi.json

# uv.lock is deliberately NOT ignored — it was until the container work, and a lockfile that
# is not in the repo pins nothing for anybody else. The Dockerfile installs with
# `uv sync --frozen`, which is the whole reason to have a lock: the image gets exactly the
# resolution that was tested, and a stale or missing lock fails the build loudly instead of
# resolving something new inside a build nobody watches. Run `git add uv.lock` once.
